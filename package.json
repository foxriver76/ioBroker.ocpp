{
  "name": "iobroker.ocpp",
  "version": "1.0.0-alpha.3",
  "description": "Adapter for OCPP 1.6",
  "author": "Moritz Heusinger <moritz.heusinger@gmail.com>",
  "contributors": [
    "iobroker-community-adapters <iobroker-community-adapters@gmx.de>"
  ],
  "homepage": "https://github.com/iobroker-community-adapters/ioBroker.ocpp",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "wallbox",
    "ocpp",
    "energy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iobroker-community-adapters/ioBroker.ocpp.git"
  },
  "dependencies": {
    "@ampeco/ocpp-eliftech": "https://github.com/ampeco/cpd-ocpp/tarball/17c0473511a6415421a367ae5e59e6be87a000e5",
    "@iobroker/adapter-core": "^3.4.3",
    "axios": "^1.21.0",
    "babel-runtime": "^6.26.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/testing": "^6.3.1",
    "@types/node": "^14.18.63",
    "@typescript-eslint/eslint-plugin": "^5.38.0",
    "@typescript-eslint/parser": "^5.38.0",
    "eslint": "^8.23.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^2.7.1",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^4.8.3"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*).json",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf ./build",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "npm run build:ts",
    "watch:ts": "tsc -p tsconfig.build.json --watch",
    "watch": "npm run watch:ts",
    "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "translate": "translate-adapter",
    "check": "tsc --noEmit",
    "lint": "eslint --ext .ts src/",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/iobroker-community-adapters/ioBroker.ocpp/issues"
  },
  "readmeFilename": "README.md",
  "engines": {
    "node": ">=22.19.0"
  }
}
